---
// Kawung (overlapping-ellipse) batik band, faded at both ends like a woven selvedge.
---
<svg class="batik-band" width="100%" height="36" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="kawung" width="36" height="36" patternUnits="userSpaceOnUse">
      <ellipse class="k" cx="18" cy="9" rx="5.5" ry="9" />
      <ellipse class="k" cx="18" cy="27" rx="5.5" ry="9" />
      <ellipse class="k" cx="9" cy="18" rx="9" ry="5.5" />
      <ellipse class="k" cx="27" cy="18" rx="9" ry="5.5" />
      <circle class="kd" cx="18" cy="18" r="1.8" />
      <circle class="kd" cx="0" cy="0" r="1.3" /><circle class="kd" cx="36" cy="0" r="1.3" />
      <circle class="kd" cx="0" cy="36" r="1.3" /><circle class="kd" cx="36" cy="36" r="1.3" />
    </pattern>
    <linearGradient id="kawung-fade" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.18" stop-color="#fff" stop-opacity="1" />
      <stop offset="0.82" stop-color="#fff" stop-opacity="1" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <mask id="kawung-mask"><rect width="100%" height="100%" fill="url(#kawung-fade)" /></mask>
  </defs>
  <rect width="100%" height="100%" fill="url(#kawung)" mask="url(#kawung-mask)" />
</svg>
