---
// A bamboo grove at dawn: three depths of ink bamboo, a low sun and drifting mist.
// The stalks are generated from a fixed seed, so the grove is the same on every build.
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const f = (n: number) => n.toFixed(1);

type Opts = { x: number; top: number; w: number; lean: number; leaf?: number; leafLen?: number; gap?: number };

/** One culm as a stroked curve plus its node marks and (optionally) leaves; returns path data strings. */
function culm(r: () => number, H: number, o: Opts) {
  const y1 = H + 20;
  const p0 = [o.x, y1], p1 = [o.x + o.lean, o.top], c = [o.x + o.lean * 0.2 + (r() - 0.5) * 14, (y1 + o.top) / 2];
  const at = (t: number) => [
    (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * c[0] + t * t * p1[0],
    (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * c[1] + t * t * p1[1],
  ];
  const body = `M${f(p0[0])} ${f(p0[1])}Q${f(c[0])} ${f(c[1])} ${f(p1[0])} ${f(p1[1])}`;
  let nodes = '', leaves = '';
  const gap = o.gap ?? 150;
  const count = Math.floor((y1 - o.top) / gap);
  for (let i = 1; i <= count; i++) {
    const t = i / (count + 1) + (r() - 0.5) * 0.04;
    const [px, py] = at(t);
    nodes += `M${f(px - o.w * 0.78)} ${f(py + 2)}L${f(px + o.w * 0.78)} ${f(py - 2)}`;
    if (o.leaf && i >= count - o.leaf + 1) {
      const side = i % 2 ? 1 : -1;
      for (let k = 0; k < 2; k++) {
        const a = (side > 0 ? -1 : 1) * (0.35 + r() * 0.55) + (side > 0 ? 0 : Math.PI) * 1 - (k ? 0.5 * side : 0);
        const L = (o.leafLen ?? 80) * (0.75 + r() * 0.5);
        const tx = px + Math.cos(a) * L, ty = py + Math.sin(a) * L;
        const mx = (px + tx) / 2, my = (py + ty) / 2;
        const nx = -Math.sin(a), ny = Math.cos(a);
        leaves += `M${f(px)} ${f(py)}Q${f(mx + nx * L * 0.17)} ${f(my + ny * L * 0.17)} ${f(tx)} ${f(ty)}Q${f(mx - nx * L * 0.09)} ${f(my - ny * L * 0.09)} ${f(px)} ${f(py)}Z`;
      }
    }
  }
  return { body, nodes, leaves };
}

function layer(seed: number, H: number, list: Opts[]) {
  const r = rng(seed);
  const out = { body: '', nodes: '', leaves: '' };
  for (const o of list) {
    const c = culm(r, H, o);
    out.body += c.body; out.nodes += c.nodes; out.leaves += c.leaves;
  }
  return out;
}

const W = 1440, H = 900;
const jitter = rng(41);
const far = layer(11, H, Array.from({ length: 17 }, (_, i) => ({ x: 20 + i * 88 + jitter() * 40, top: -30 + jitter() * 230, w: 6 + jitter() * 4, lean: (jitter() - 0.5) * 50, gap: 120 + jitter() * 40 })));
const mid = layer(23, H, Array.from({ length: 10 }, (_, i) => ({ x: 60 + i * 150 + jitter() * 70, top: -30 + jitter() * 150, w: 13 + jitter() * 6, lean: (jitter() - 0.5) * 60, leaf: 3, leafLen: 70, gap: 140 + jitter() * 30 })));
const nearL = layer(5, H, [
  { x: 54, top: -40, w: 40, lean: 16, leaf: 4, leafLen: 150, gap: 160 },
  { x: 150, top: -40, w: 28, lean: -12, leaf: 3, leafLen: 130, gap: 150 },
  { x: 250, top: 120, w: 18, lean: 10, leaf: 2, leafLen: 100, gap: 140 },
]);
const nearR = layer(9, H, [
  { x: 470, top: -40, w: 38, lean: -18, leaf: 4, leafLen: 150, gap: 165 },
  { x: 370, top: 60, w: 24, lean: 12, leaf: 3, leafLen: 120, gap: 150 },
  { x: 290, top: 240, w: 16, lean: -8, leaf: 2, leafLen: 90, gap: 135 },
]);
---
<div class="grove" aria-hidden="true">
  <div class="g-deep">
    <div class="g-glow"></div>
    <svg class="g-far" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      <g filter="url(#ink-wash)" fill="none" stroke-linecap="round">
        <path d={far.body} class="stk stk-far" />
        <path d={far.nodes} class="nod stk-far" />
      </g>
    </svg>
    <svg class="g-sun" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      <g class="sun-g">
        <circle class="orb orb-sun" cx="720" cy="330" r="118" filter="url(#ink-rough)" />
        <circle class="orb orb-moon" cx="720" cy="330" r="74" filter="url(#ink-rough)" />
      </g>
    </svg>
    <svg class="g-mist g-mist-a" viewBox={`0 0 ${W * 2} ${H}`} preserveAspectRatio="none" focusable="false">
      <g class="mist" filter="url(#ink-mist)">
        <ellipse cx="500" cy="610" rx="620" ry="46" /><ellipse cx="1500" cy="560" rx="560" ry="40" />
        <ellipse cx="2300" cy="620" rx="520" ry="46" />
      </g>
    </svg>
    <svg class="g-mid" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      <g filter="url(#ink-wash)" fill="none" stroke-linecap="round">
        <path d={mid.body} class="stk stk-mid" />
        <path d={mid.nodes} class="nod stk-mid" />
        <path d={mid.leaves} class="leaf leaf-mid" stroke="none" />
      </g>
    </svg>
    <svg class="g-mist g-mist-b" viewBox={`0 0 ${W * 2} ${H}`} preserveAspectRatio="none" focusable="false">
      <g class="mist mist-low" filter="url(#ink-mist)">
        <ellipse cx="700" cy="770" rx="700" ry="60" /><ellipse cx="1900" cy="740" rx="640" ry="56" />
      </g>
    </svg>
  </div>
  <div class="g-front">
    <svg class="g-near g-near-l" viewBox="0 0 520 900" preserveAspectRatio="xMinYMax slice" focusable="false">
      <g filter="url(#ink-rough)" fill="none" stroke-linecap="round">
        <path d={nearL.body} class="stk stk-near" />
        <path d={nearL.nodes} class="nod stk-near" />
        <path d={nearL.leaves} class="leaf leaf-near" stroke="none" />
      </g>
    </svg>
    <svg class="g-near g-near-r" viewBox="0 0 520 900" preserveAspectRatio="xMaxYMax slice" focusable="false">
      <g filter="url(#ink-rough)" fill="none" stroke-linecap="round">
        <path d={nearR.body} class="stk stk-near" />
        <path d={nearR.nodes} class="nod stk-near" />
        <path d={nearR.leaves} class="leaf leaf-near" stroke="none" />
      </g>
    </svg>
  </div>
</div>
