---
import { describe, fmtShort, readingMinutes, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <a class="title" href={`/blog/${p.id}/`}>{p.data.title}</a>
      {p.data.draft && <span class="badge">Draft</span>}
      <p>{describe(p)}</p>
      <div class="meta">
        <time datetime={p.data.pubDate.toISOString()}>{fmtShort(p.data.pubDate)}</time>
        <span>{readingMinutes(p.body)} min read</span>
        {p.data.tags.map((t) => <a class="chip" href={`/blog/tags/${t}/`}>{t}</a>)}
      </div>
    </li>
  ))}
</ul>
