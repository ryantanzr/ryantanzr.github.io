---
import '../styles/global.css';
import { site } from '../data/site';
import InkDefs from '../components/InkDefs.astro';
import BatikBand from '../components/BatikBand.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}
const { title, description = site.tagline, type = 'website', published, updated, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isBlog = path.startsWith('/blog');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#efe8d8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href="/fonts/Minoru.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      var t = null; try { t = localStorage.getItem('theme'); } catch (e) {} if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.theme = t; if (window.top !== window.self) document.documentElement.style.display = 'none';
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          <a href="/#journey">Journey</a>
          <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a>
          <a href="/resume/" aria-current={path.startsWith('/resume') ? 'page' : undefined}>Resume</a>
          <button class="theme-btn" id="theme" type="button" aria-label="Toggle dark mode">
            <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <canvas id="fx" aria-hidden="true"></canvas>
    <InkDefs /><main class="wrap" id="main"><slot /></main>
    <div class="wrap"><BatikBand /></div>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {year} {site.fullName}</span>
        <span class="links">
          <a href={site.github} rel="me noopener noreferrer">GitHub</a>
          <a href={site.linkedin} rel="me noopener noreferrer">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/particles';
    </script>
  </body>
</html>
