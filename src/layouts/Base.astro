---
import '../styles/global.css';
import { site } from '../data/site';
import InkDefs from '../components/InkDefs.astro';
import Beads from '../components/Beads.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  bleed?: boolean;
}
const { title, description = site.tagline, type = 'website', published, updated, noindex = false, bleed = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isBlog = path.startsWith('/blog');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e8ead3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141a0f" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href="/fonts/ShipporiMincho-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      var t = null; try { t = localStorage.getItem('theme'); } catch (e) {} if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.theme = t; if (window.top !== window.self) document.documentElement.style.display = 'none';
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap wide">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          <a href="/#journey">Journey</a>
          <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a>
          <a href="/resume/" aria-current={path.startsWith('/resume') ? 'page' : undefined}>Resume</a>
          <button class="theme-btn" id="theme" type="button" aria-label="Toggle dark mode">
            <svg class="lotus-tg" viewBox="0 0 48 32" width="26" height="17" aria-hidden="true" focusable="false">
              <path class="tp tp-out-l" d="M24 29C12 30 4 25 2 17c7 0 16 4 22 12z" />
              <path class="tp tp-out-r" d="M24 29c12 1 20-4 22-12-7 0-16 4-22 12z" />
              <path class="tp tp-mid-l" d="M24 28C14 26 9 18 10 9c7 3 12 10 14 19z" />
              <path class="tp tp-mid-r" d="M24 28c10-2 15-10 14-19-7 3-12 10-14 19z" />
              <path class="tp tp-c" d="M24 4c5 7 6 16 0 24-6-8-5-17 0-24z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <canvas id="fx" aria-hidden="true"></canvas>
    <InkDefs /><main class={bleed ? undefined : 'wrap'} id="main"><slot /></main>
    <div class="wrap wide"><Beads /></div>
    <footer class="site-footer">
      <div class="wrap wide">
        <span>© {year} {site.fullName}</span>
        <span class="links">
          <a href={site.github} rel="me noopener noreferrer">GitHub</a>
          <a href={site.linkedin} rel="me noopener noreferrer">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/particles';
    </script>
  </body>
</html>
