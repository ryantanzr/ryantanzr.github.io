---
import '../styles/global.css';
import { site } from '../data/site';
import InkDefs from '../components/InkDefs.astro';
import BatikBand from '../components/BatikBand.astro';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; }
const { title, description = site.tagline, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isBlog = path.startsWith('/blog');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href="/fonts/Minoru.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      var t = null; try { t = localStorage.getItem('theme'); } catch (e) {} if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.theme = t; if (window.top !== window.self) document.documentElement.style.display = 'none';
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          <a href="/#journey">Journey</a>
          <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a>
          <a href="/resume/" aria-current={path.startsWith('/resume') ? 'page' : undefined}>Resume</a>
          <button class="theme-btn" id="theme" type="button" aria-label="Toggle dark mode">◐</button>
        </nav>
      </div>
    </header>
    <canvas id="fx" aria-hidden="true"></canvas>
    <InkDefs /><main class="wrap"><slot /></main>
    <div class="wrap"><BatikBand /></div>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {year} {site.fullName}</span>
        <span class="links">
          <a href={site.github} rel="me noopener noreferrer">GitHub</a>
          <a href={site.linkedin} rel="me noopener noreferrer">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
    <script>
      import '../scripts/theme';
      import '../scripts/particles';
    </script>
  </body>
</html>
