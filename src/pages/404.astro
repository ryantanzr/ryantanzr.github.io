---
import Base from '../layouts/Base.astro';
import InkRule from '../components/InkRule.astro';
---
<Base title="Not found" description="This page does not exist.">
  <div class="post-head flush lost">
    <h1>Lost in the mist</h1>
    <p class="lede muted m0">That page isn't here. It may have moved, or the link may have a typo.</p>
    <InkRule />
    <div class="btns">
      <a class="btn primary" href="/">Back home</a>
      <a class="btn" href="/blog/">Read the blog</a>
    </div>
  </div>
</Base>
