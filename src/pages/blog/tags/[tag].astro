---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', (p) => !p.data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <div class="post-head" style="border:0;margin-bottom:0">
    <p class="eyebrow"><a href="/blog/" style="text-decoration:none">/blog</a>/tags</p>
    <h1>#{tag}</h1>
  </div>
  <PostList posts={posts} />
</Base>
