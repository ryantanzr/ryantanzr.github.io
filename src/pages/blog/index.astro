---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import InkRule from '../../components/InkRule.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="Notes on backend engineering, distributed systems and serverless.">
  <div class="post-head" style="border:0;padding-bottom:0;margin-bottom:0">
    <p class="eyebrow">Blog</p>
    <h1>Writing</h1>
    <p style="color:var(--muted);margin:0">Notes on backend engineering, distributed systems and serverless. <a href="/rss.xml">RSS</a></p>
    <InkRule />
  </div>
  {tags.length > 0 && (
    <div class="tag-filter">
      {tags.map((t) => <a class="chip" href={`/blog/tags/${t}/`}>{t}</a>)}
    </div>
  )}
  <PostList posts={posts} />
</Base>
