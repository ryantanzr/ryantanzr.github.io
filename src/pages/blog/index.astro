---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import InkRule from '../../components/InkRule.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const tags = [...new Set(posts.filter((p) => !p.data.draft).flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="Notes on backend engineering, distributed systems and serverless.">
  <div class="post-head flush">
    <h1>Writing</h1>
    <p class="muted m0 intro">Notes on backend engineering, distributed systems and serverless. <a href="/rss.xml">RSS</a></p>
    <InkRule />
  </div>
  {tags.length > 0 && (
    <nav class="tag-filter" aria-label="Filter by tag">
      {tags.map((t) => <a class="chip" href={`/blog/tags/${t}/`}>{t}</a>)}
    </nav>
  )}
  {posts.length > 0
    ? <PostList posts={posts} />
    : <p class="muted empty">Nothing here yet. The first post is on its way.</p>}
</Base>
